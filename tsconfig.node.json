{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "types": ["electron-vite/node"]
  },
  "include": [
    "drizzle.config.ts",
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
